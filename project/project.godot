; Engine configuration file.
config_version=5

[application]

config/name="Swan Lake"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

buses/default_bus_layout=""

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[xr]

openxr/render_target_size_multiplier=1.35

openxr/enabled=true
openxr/foveation_level=2
openxr/foveation_dynamic=true
; Fort (sibling project, same vendors plugin) traced their face/eye tracking
; dead end to two separate causes: an unrelated extension left off by default,
; AND permissions that were declared in the manifest but never actually
; requested at runtime — no in-VR consent dialog ever fired, so the OS-level
; grant state was inconsistent across devices (confirmed: some of tonight's
; units had HAND_TRACKING pre-granted, one needed it explicitly pm-granted).
; This flag makes the runtime properly request needed permissions instead of
; depending on ambient grant state.
openxr/extensions/automatically_request_runtime_permissions=true
openxr/extensions/hand_tracking=true
; Only the UNOBSTRUCTED source. The controller data source makes the runtime
; synthesize hand poses FROM the controllers, so the hand tracker reports
; has_tracking_data while you're holding controllers and shadows the real
; controller input — the bug that survived four rounds on Tank Commander VR.
; Leaving it off means "hand tracker has data" cleanly implies "bare hands".
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=false
; Deliberately OFF. It made PICO's runtime report "ActiveInputType is hand" and
; spam XR_ERROR_PERMISSION_INSUFFICIENT for every action float — the same class of
; hazard as Tank Commander VR v0.6.16, where the hand-aim profile hijacked the
; controller menu ray. Pinch here is measured from joint positions, not from this
; profile's actions, so nothing is lost by leaving it off.
openxr/extensions/hand_interaction_profile=false
shaders/enabled=true
